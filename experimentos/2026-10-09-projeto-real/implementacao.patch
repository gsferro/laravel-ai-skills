+            ->line('Centro de custo: '.$this->solicitacao->centroCusto->nome)
+            ->action('Ver solicitação', SolicitacaoCompraResource::getUrl('view', ['record' => $this->solicitacao], panel: 'app', tenant: $this->solicitacao->tenant));
+    }
