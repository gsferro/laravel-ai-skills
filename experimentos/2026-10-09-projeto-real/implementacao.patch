+    }
+
+    private function transicionar(SituacaoSolicitacao $de, SituacaoSolicitacao $para, string $metodo): void
+    {
+        $mudou = static::query()->whereKey($this->id)->where('situacao', $de->value)->update(['situacao' => $para->value, 'updated_at' => now()]);
