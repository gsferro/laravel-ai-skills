+            $registrar->setPermissionsTeamId($this->tenant_id ?? Tenant::CONTEXTO_GLOBAL);
+
+            return User::role('diretor')->get();
+        } finally {
+            $registrar->setPermissionsTeamId($anterior);
+        }
+    }
+
+    public function enviar(User $autor): void
